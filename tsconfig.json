{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["./worker-configuration.d.ts"],
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "worker-configuration.d.ts",
    "node_modules/@cloudflare/vitest-plugin/types/cloudflare-test.d.ts"
  ]
}
